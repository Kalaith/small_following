  "lines": [
    {"bar": 5, "beat": 1, "voice": "lead", "syl": "Woke up in Bram-ble-wick, face down on the desk,", "notes": "A4:.5 A4:.5 G4:.5 A4:1 G4:.5 E4:1 r:.5 C5:.5 B4:.5 A4:.5 B4:.5 A4:1.5"},
    {"bar": 7, "beat": 1, "voice": "lead", "syl": "I asked the gar-den club - three of them said may-be,", "notes": "E4:.5 G4:.5 A4:.5 A4:.5 G4:.5 A4:1 r:.5 B4:.5 C5:.5 B4:.5 A4:.5 G4:.5 A4:1.5"},
    {"bar": 9, "beat": 1, "voice": "lead", "syl": "they brought a-long nine coins, I count-ed them twice,", "notes": "A4:.5 A4:.5 G4:.5 A4:.5 C5:1 B4:1 r:.5 A4:.5 G4:.5 A4:.5 B4:.5 A4:1"},
    {"bar": 11, "beat": 1, "voice": "lead", "syl": "and Ger-ald brought a pie.", "notes": "E4:.5 G4:.5 A4:.5 C5:.5 B4:.5 A4:2 r:3"},

    {"bar": 13, "beat": 1, "voice": "lead", "syl": "Draw a lit-tle cir-cle, slight-ly wonk-y,", "notes": "C5:.5 C5:.5 B4:.5 C5:.5 D5:1 C5:.5 r:.5 B4:.5 A4:.5 B4:1 G4:1.5"},
    {"bar": 15, "beat": 1, "voice": "lead", "syl": "Talk-ing One, in-scribed, now I can't stop talk-ing!", "notes": "E5:.5 D5:.5 C5:1 C5:.5 E5:1 r:.5 C5:.25 D5:.25 E5:.25 D5:.25 C5:.25 E5:2.25"},

    {"bar": 17, "beat": 1, "voice": "lead", "syl": "It's just a small fol-low-ing", "notes": "G4:.5 A4:.5 C5:.5 E5:1.5 D5:.5 C5:.5 C5:1"},
    {"bar": 18, "beat": 2, "voice": "choir", "syl": "(small fol-low-ing),", "notes": "E5:1 D5:.5 C5:.5 A4:1"},
    {"bar": 19, "beat": 1, "voice": "lead", "syl": "noth-ing a-larm-ing,", "notes": "E5:.5 D5:.5 C5:.5 D5:.5 C5:1 r:1"},
    {"bar": 20, "beat": 1, "voice": "lead", "syl": "we've got bis-cuits and a robe.", "notes": "C5:.5 C5:.5 E5:.5 D5:.5 C5:.25 B4:.25 C5:1.5"},
    {"bar": 21, "beat": 1, "voice": "lead", "syl": "And in e-lev-en sec-onds", "notes": "G4:.5 A4:.5 C5:.5 E5:.5 D5:.5 C5:.5 C5:1"},
    {"bar": 22, "beat": 2, "voice": "shout", "syl": "(plus one!)", "notes": "x:.5 x:1"},
    {"bar": 23, "beat": 1, "voice": "lead", "syl": "we'll be ask-ing you a-gain.", "notes": "C5:.5 D5:.5 E5:1 D5:.5 C5:.5 B4:.5 A4:2.5"},

    {"bar": 25, "beat": 1, "voice": "lead", "syl": "Some mer-chants from the square rent-ed us a stall,", "notes": "A4:.5 A4:.5 G4:.5 A4:.5 G4:.5 E4:1 r:.5 C5:.5 B4:.5 A4:.5 B4:.5 A4:1.5"},
    {"bar": 27, "beat": 1, "voice": "lead", "syl": "I hired some-one dressed in teal -", "notes": "E4:.5 G4:.5 A4:.5 A4:.5 C5:.5 B4:.5 A4:1"},
    {"bar": 28, "beat": 1, "voice": "teal", "syl": "Join us! Join us!", "notes": "C5:.5 C5:.5 E5:.5 E5:1.5"},
    {"bar": 29, "beat": 1, "voice": "lead", "syl": "That's e-nough.", "notes": "A4:.5 G4:.5 E4:1"},

    {"bar": 33, "beat": 1, "voice": "lead", "syl": "Make the cir-cle big-ger, move the chairs a-side,", "notes": "C5:.5 C5:.5 B4:.5 C5:.5 D5:.5 C5:.5 r:.5 B4:.5 A4:.5 B4:.5 C5:.5 D5:1.5"},
    {"bar": 35, "beat": 1, "voice": "lead", "syl": "we're grow-ing world-wide!", "notes": "E5:.5 D5:.5 C5:.5 E5:1 E5:1.5"},
    {"bar": 36, "beat": 2, "voice": "whisper", "syl": "(with-in walk-ing dis-tance)", "notes": "x:.25 x:.25 x:.5 x:.25 x:.25 x:1"},

    {"bar": 37, "beat": 1, "voice": "lead", "syl": "It's just a small fol-low-ing", "notes": "G4:.5 A4:.5 C5:.5 E5:1.5 D5:.5 C5:.5 C5:1"},
    {"bar": 38, "beat": 2, "voice": "choir", "syl": "(small fol-low-ing),", "notes": "E5:1 D5:.5 C5:.5 A4:1"},
    {"bar": 39, "beat": 1, "voice": "lead", "syl": "noth-ing a-larm-ing,", "notes": "E5:.5 D5:.5 C5:.5 D5:.5 C5:1 r:1"},
    {"bar": 40, "beat": 1, "voice": "lead", "syl": "please ig-nore the ex-tra robes.", "notes": "C5:.5 C5:.5 E5:.5 D5:.5 C5:.25 B4:.25 C5:1.5"},
    {"bar": 41, "beat": 1, "voice": "lead", "syl": "There's hard-ly an-y-bo-dy,", "notes": "G4:.5 A4:.5 C5:.5 E5:1 D5:.5 C5:.5 C5:.5"},
    {"bar": 42, "beat": 2, "voice": "choir", "syl": "(hard-ly an-y-one),", "notes": "E5:.5 D5:.5 C5:.5 D5:.5 A4:1"},
    {"bar": 43, "beat": 1, "voice": "lead", "syl": "we on-ly moved the ta-bles,", "notes": "C5:.5 D5:.25 E5:.25 E5:.5 D5:.5 C5:.5 A4:.5 r:1"},
    {"bar": 44, "beat": 1, "voice": "lead", "syl": "just to squeeze a few more in.", "notes": "C5:.5 C5:.25 E5:1 D5:.25 C5:.5 B4:.5 A4:1"},

    {"bar": 45, "beat": 1, "voice": "priest", "syl": "No.", "notes": "A2:3"},
    {"bar": 46, "beat": 1, "voice": "shout", "syl": "OB-JEC-TION!", "notes": "x:.5 x:.5 x:1"},
    {"bar": 47, "beat": 1, "voice": "priest", "syl": "Ab-so-lute-ly no.", "notes": "C3:.5 C3:.5 B2:.5 A2:.5 A2:2"},
    {"bar": 48, "beat": 1, "voice": "shout", "syl": "OB-JEC-TION!", "notes": "x:.5 x:.5 x:1.5"},
    {"bar": 49, "beat": 1, "voice": "priest", "syl": "I said no.", "notes": "A2:1 C3:1 A2:2"},
    {"bar": 50, "beat": 1, "voice": "shout", "syl": "OB-JEC-TION!", "notes": "x:.5 x:.5 x:2"},
    {"bar": 52, "beat": 1, "voice": "priest", "syl": "...fine.", "notes": "A2:2"},

    {"bar": 53, "beat": 1, "voice": "lead", "syl": "It's just a small fol-low-ing!", "notes": "G4:.5 A4:.5 C5:.5 E5:1.5 D5:.5 C5:.5 C5:1"},
    {"bar": 55, "beat": 1, "voice": "lead", "syl": "A per-fect-ly small fol-low-ing!", "notes": "G4:.5 A4:.5 C5:.5 D5:.5 E5:1.5 D5:.5 C5:.5 C5:1"},
    {"bar": 57, "beat": 1, "voice": "lead", "syl": "Bell-mar-ket is wait-ing,", "notes": "E5:.5 D5:.5 C5:.5 D5:.5 E5:1 C5:1"},
    {"bar": 58, "beat": 1, "voice": "lead", "syl": "there's real-ly not that man-y!", "notes": "C5:.5 D5:.5 E5:.5 D5:.5 C5:.5 D5:.5 C5:1"},
    {"bar": 59, "beat": 1, "voice": "whisper", "syl": "How man-y?", "notes": "x:.5 x:.5 x:1"},
    {"bar": 60, "beat": 1, "voice": "lead", "syl": "...stop count-ing.", "notes": "A4:1 A4:.5 A4:1.5"},

    {"bar": 61, "beat": 1, "voice": "whisper", "syl": "Psst.", "notes": "x:1"},
    {"bar": 61, "beat": 3, "voice": "whisper", "syl": "Don't feel like do-ing the vil-lage?", "notes": "x:.5 x:.25 x:.25 x:.5 x:.25 x:.25 x:.5 x:1"},
    {"bar": 62, "beat": 3, "voice": "whisper", "syl": "Don't tell the dev.", "notes": "x:.5 x:.5 x:.5 x:1.5"},
    {"bar": 64, "beat": 1, "voice": "lead", "syl": "...right.", "notes": "A4:1"},
    {"bar": 64, "beat": 3, "voice": "lead", "syl": "Not that one.", "notes": "A4:.5 G4:.5 A4:1"},

    {"bar": 65, "beat": 1, "voice": "shout", "syl": "P! L! Z! K!", "notes": "x:1 x:1 x:1 x:1"},
    {"bar": 66, "beat": 1, "voice": "shout", "syl": "T! K! S!", "notes": "x:1 x:1 x:2"},
    {"bar": 67, "beat": 1, "voice": "choir", "syl": "PLEASE! O-KAY! THANKS!", "notes": "C5:1 E5:.5 D5:.5 C5:2"},

    {"bar": 69, "beat": 1, "voice": "lead", "syl": "Some-day, a gar-den...", "notes": "E4:.5 G4:.5 A4:.5 C5:1 B4:3.5"},
    {"bar": 71, "beat": 1, "voice": "lead", "syl": "a har-bour of cap-tains,", "notes": "A4:.5 C5:1 B4:.5 A4:.5 G4:1 E4:3"},
    {"bar": 73, "beat": 1, "voice": "lead", "syl": "a fair full of friends,", "notes": "A4:.5 C5:1 B4:.5 A4:1 A4:3"},
    {"bar": 75, "beat": 1, "voice": "lead", "syl": "a tow-er of star-gaz-ers,", "notes": "E4:.5 G4:.5 A4:.5 C5:.5 D5:1 C5:.5 B4:3"},
    {"bar": 77, "beat": 1, "voice": "lead", "syl": "an ab-bey up high,", "notes": "C5:.5 B4:.5 A4:.5 G4:1 A4:4"},
    {"bar": 79, "beat": 1, "voice": "lead", "syl": "some help-ful lit-tle help-ers, and some ma-gic... prob-ab-ly.", "notes": "E4:.5 G4:.5 A4:.25 C5:.25 B4:.25 A4:.25 G4:.5 r:.5 A4:.5 B4:.25 C5:.75 A4:1 E4:.5 G4:.5 A4:1"},

    {"bar": 82, "beat": 1, "voice": "lead", "syl": "Or twen-ty.", "notes": "A4:.5 C5:.5 A4:2"},
    {"bar": 83, "beat": 1, "voice": "lead", "syl": "Twen-ty would be nice.", "notes": "A4:.5 B4:.5 C5:.5 B4:.5 A4:2"},

    {"bar": 85, "beat": 1, "voice": "lead", "syl": "It's just a small fol-low-ing,", "notes": "G4:.5 A4:.5 C5:.5 E5:1.5 D5:.5 C5:.5 C5:1"},
    {"bar": 86, "beat": 2, "voice": "choir", "syl": "(small fol-low-ing),", "notes": "E5:1 D5:.5 C5:.5 A4:1"},
    {"bar": 87, "beat": 1, "voice": "lead", "syl": "a per-fect-ly small fol-low-ing,", "notes": "G4:.5 A4:.5 C5:.5 D5:.5 E5:1 D5:.5 C5:.5 C5:1"},
    {"bar": 89, "beat": 1, "voice": "lead", "syl": "a hand-ful of be-liev-ers,", "notes": "G4:.5 A4:.5 C5:.5 E5:.5 D5:1 C5:.5 C5:1"},
    {"bar": 91, "beat": 1, "voice": "lead", "syl": "and some bis-cuits in a tin!", "notes": "C5:.5 D5:.5 E5:1 D5:.5 C5:.5 B4:.5 C5:2.5"},

    {"bar": 93, "beat": 1, "voice": "lead", "syl": "It's just a small fol-low-ing...", "notes": "G4:.5 A4:.5 C5:.5 E5:1.5 D5:.5 C5:.5 C5:3"},
    {"bar": 95, "beat": 3, "voice": "solo", "syl": "...for now.", "notes": "A4:.5 A4:1.5"}
